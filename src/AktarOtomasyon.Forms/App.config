<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
  </configSections>
  
  <connectionStrings>
    <!-- Veritabanı bağlantı dizesi - deploy sırasında override edilecek -->
    <add name="Db" 
         connectionString="Server=.\SQLEXPRESS;Database=AktarOtomasyon;Trusted_Connection=True;TrustServerCertificate=True;" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  
  <appSettings>
    <!-- Uygulama sürümü -->
    <add key="AppVersion" value="1.0.0" />

    <!-- Report ve Template path'leri -->
    <add key="ReportPath" value=".\reports" />
    <add key="TemplatePath" value=".\templates" />

    <!-- AI Provider ayarları
         Gerçek anahtarı buraya yazma (commit riski).
         Öncelik: ortam değişkeni AI_API_KEY → App_Data\ai.local.key → bu değer.
         Örnek: setx AI_API_KEY "AIza..." -->
    <add key="AI_PROVIDER" value="GEMINI" />
    <add key="AI_MODEL" value="gemini-3.5-flash" />
    <add key="AI_API_KEY" value="" />
    <add key="AI_TIMEOUT_SECONDS" value="60" />
    <add key="AI_MAX_RETRY" value="2" />

    <!-- Kullanım etiketi yazıcısı (boş = yazdırırken seçilir; POS değil, Windows etiket yazıcısı) -->
    <add key="LABEL_PRINTER_NAME" value="" />
    <add key="LABEL_WIDTH_MM" value="58" />
    <add key="LABEL_HEIGHT_MM" value="40" />
  </appSettings>
  
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
